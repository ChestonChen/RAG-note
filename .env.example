DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/ragdb
KNOWLEDGE_ROOT=knowledge
# Evaluation APIs accept only relative case paths beneath this directory.
EVAL_CASES_ROOT=eval

# Hashing is an explicit smoke-test provider only. Production deployments should
# select one of the BGE-M3 examples below and use the model's actual dimension.
EMBEDDING_PROVIDER=hashing
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# Remote OpenAI-compatible BGE-M3 endpoint:
# EMBEDDING_PROVIDER=openai_compatible
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_API_KEY=replace-with-provider-key
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_DIMENSIONS=1024
# Local BGE-M3 model directory (loaded lazily on first embedding request):
# EMBEDDING_PROVIDER=sentence_transformers
# EMBEDDING_MODEL=models/bge-m3
# EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cpu
# Active hashing smoke-provider dimension. If you uncomment either BGE-M3
# example above, change this active value to the model's actual dimension (1024).
EMBEDDING_DIMENSIONS=384

LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=60

# Optional web fallback. Tavily is enabled only when both the flag and key are set.
WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=none
TAVILY_API_KEY=
WEB_SEARCH_PROXY_URL=
WEB_SEARCH_PROXY_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_SECONDS=20
WEB_FALLBACK_SCORE_THRESHOLD=0.28

# Optional AI-as-a-judge. Empty judge values fall back to the LLM settings.
EVAL_JUDGE_BASE_URL=
EVAL_JUDGE_API_KEY=
EVAL_JUDGE_MODEL=
EVAL_JUDGE_TIMEOUT_SECONDS=60

# Protect ingestion, logs, and evaluation administration endpoints.
ADMIN_API_KEY=

CHUNK_MAX_TOKENS=520
CHUNK_OVERLAP_TOKENS=80
CHUNKING_VERSION=chunk-v1
PARSER_VERSION=parser-v1
RETRIEVAL_VECTOR_CANDIDATES=30
RETRIEVAL_VECTOR_MIN_SCORE=0.12
RETRIEVAL_KEYWORD_CANDIDATES=30
RETRIEVAL_PHRASE_CANDIDATES=20
RETRIEVAL_TRIGRAM_CANDIDATES=30
RETRIEVAL_TRIGRAM_MIN_SIMILARITY=0.1
RETRIEVAL_VECTOR_RRF_WEIGHT=1.0
RETRIEVAL_KEYWORD_RRF_WEIGHT=1.0
RETRIEVAL_PHRASE_RRF_WEIGHT=1.0
RETRIEVAL_TRIGRAM_RRF_WEIGHT=0.5
RETRIEVAL_CONTEXT_LIMIT=8
RETRIEVAL_NEIGHBOR_WINDOW=1
RETRIEVAL_PER_DOCUMENT_LIMIT=5
RETRIEVAL_QUERY_EXPANSION_ENABLED=true
RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# After downloading the model under this project, use an absolute local path:
# RERANKER_ENABLED=true
# RERANKER_MODEL=D:/project/rag-knowledge-base/models/bge-reranker-v2-m3
RERANKER_DEVICE=cpu
RERANKER_BATCH_SIZE=4
RERANKER_CANDIDATES=24
RERANKER_MAX_CHARS=1200
RERANKER_WEIGHT=0.35
RERANKER_FAIL_OPEN=true
LOW_CONFIDENCE_THRESHOLD=0.28
